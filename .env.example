# Токен от @BotFather
BOT_TOKEN=

# Telegram ID тех, кому можно пользоваться ботом, через запятую.
# Свой ID бот покажет, если написать ему /start.
ALLOWED_USER_IDS=

# Адрес локального Bot API сервера: поднимает лимит отправки с 50 МБ до 2 ГБ.
# В Docker: http://telegram-bot-api:8081, без Docker: http://localhost:8081
BOT_API_URL=

# Для локального Bot API сервера в Docker, значения с https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Необязательно: cookies в формате Netscape, если площадка требует входа.
# Используйте отдельный аккаунт: за скачивание его могут заблокировать.
COOKIES_FILE=

# Необязательно: прокси для скачивания, например socks5://127.0.0.1:1080
YTDLP_PROXY=

# Необязательно: папка для настроек и кэша. В Docker менять не нужно.
DATA_DIR=

# Сколько видео обрабатывать одновременно
MAX_CONCURRENT_DOWNLOADS=2

# Раз в сутки обновлять yt-dlp до свежей ночной сборки (true/false)
YTDLP_AUTO_UPDATE=true
